      "roundness": { "type": 3 }
    },
    {
      "id": "sec-config-text",
      "type": "text",
      "x": 75,
      "y": 135,
      "width": 270,
      "height": 60,
      "text": "SecurityConfig\n+securityFilterChain(HttpSecurity)\n-> configures stateless JWT & rules",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#0369a1"
    },
    {
      "id": "arrow-builds",
      "type": "arrow",
      "x": 210,
      "y": 210,
      "width": 0,
      "height": 60,
      "strokeColor": "#0284c7",
      "strokeWidth": 2,
      "points": [[0, 0], [0, 60]],
      "startBinding": { "elementId": "sec-config-box" },
      "endBinding": { "elementId": "filter-chain-box" },
      "endArrowhead": "arrow"
    },
    {
      "id": "filter-chain-box",
      "type": "rectangle",
      "x": 60,
      "y": 270,
      "width": 300,
      "height": 80,
      "strokeColor": "#2563eb",
      "backgroundColor": "#dbeafe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "filter-chain-text",
      "type": "text",
      "x": 75,
      "y": 285,
      "width": 270,
      "height": 50,
      "text": "SecurityFilterChain\n+List<Filter> filters (Ordered)\nMatches incoming HTTP requests",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1d4ed8"
    },
    {
      "id": "filter-1-box",
      "type": "rectangle",
      "x": 40,
      "y": 400,
      "width": 150,
      "height": 90,
      "strokeColor": "#e11d48",
      "backgroundColor": "#ffe4e6",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "filter-1-text",
      "type": "text",
      "x": 45,
      "y": 410,
      "width": 140,
      "height": 70,
      "text": "1. IpRateLimiterFilter\n(Bucket4j)\nRate limits per IP\nReturns HTTP 429",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#be123c"
    },
    {
      "id": "filter-2-box",
      "type": "rectangle",
      "x": 210,
      "y": 400,
      "width": 160,
      "height": 90,
      "strokeColor": "#059669",
      "backgroundColor": "#d1fae5",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "filter-2-text",
      "type": "text",
      "x": 215,
      "y": 410,
      "width": 150,
      "height": 70,
      "text": "2. JwtAuthFilter\nExtracts Bearer token\nValidates with JwtService\nSets SecurityContext",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#047857"
    },
    {
      "id": "filter-3-box",
      "type": "rectangle",
      "x": 390,
      "y": 400,
      "width": 160,
      "height": 90,
      "strokeColor": "#d97706",
      "backgroundColor": "#fef3c7",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "filter-3-text",
      "type": "text",
      "x": 395,
      "y": 410,
      "width": 150,
      "height": 70,
      "text": "3. AuthorizationFilter\nGatekeeper\nChecks request rules\nPermits or Denies",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#b45309"
    },
    {
      "id": "sec-context-box",
