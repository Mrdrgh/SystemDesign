      "width": 260,
      "height": 90,
      "strokeColor": "#7c3aed",
      "backgroundColor": "#ede9fe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "sec-context-text",
      "type": "text",
      "x": 210,
      "y": 560,
      "width": 240,
      "height": 70,
      "text": "<<static>>\nSecurityContextHolder\n+getContext(): SecurityContext\n+setAuthentication(auth)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "strokeColor": "#6d28d9"
    },
    {
