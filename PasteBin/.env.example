# ==============================================================================
# PasteBin Infrastructure Environment Template (.env.example)
# Copy this file to '.env' and adjust values as needed for your environment.
# ==============================================================================

# --- MySQL Database ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pastebin

# --- Redis In-Memory Cache & Queue ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EVENTS_QUEUE=pastebin_events

# --- MinIO (S3 Compatible Object Storage) ---
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=pastebin
